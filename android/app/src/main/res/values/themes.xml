<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme is applied by Compose; this only styles the pre-Compose
         window + the SplashScreen (androidx.core:core-splashscreen). -->
    <style name="Theme.TrueSiteSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tss_splash_bg</item>
        <item name="android:statusBarColor">@color/tss_navy</item>
        <item name="android:navigationBarColor">@color/tss_navy</item>
    </style>

    <style name="Theme.TrueSiteSync.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tss_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TrueSiteSync</item>
    </style>
</resources>
